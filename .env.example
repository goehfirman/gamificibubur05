# =============================================================================
# GAMICLASS ENVIRONMENT VARIABLES CONFIGURATION (VERCEL & LOCAL)
# =============================================================================

# 1. FIREBASE CONFIGURATION (PILIH SALAH SATU: Opsi A atau Opsi B)
# -----------------------------------------------------------------------------
# OPSI A (Paling Mudah & Direkomendasikan untuk Vercel):
# Download Service Account JSON dari Firebase Console -> Project Settings -> Service accounts
# Buka file JSON tersebut, copy seluruh isinya, lalu paste ke FIREBASE_SERVICE_ACCOUNT.
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-...@your-project-id.iam.gserviceaccount.com"}'

# OPSI B (Variabel Terpisah):
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# OPTIONAL: ID database Firestore jika menggunakan custom database (default: (default))
FIRESTORE_DATABASE_ID="(default)"

# -----------------------------------------------------------------------------
# 2. GEMINI AI CONFIGURATION (Untuk Ekstraksi Soal Quiz Otomatis)
# -----------------------------------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key"

# -----------------------------------------------------------------------------
# 3. ALTERNATIF DATABASE (Opsional jika menggunakan Postgres alih-alih Firebase)
# -----------------------------------------------------------------------------
# POSTGRES_URL="postgres://user:password@host:port/database"
